# Copy to api/.env and adjust. Every key the API reads is listed here.

# local | test | staging | production
# staging/production refuse to start without: Postgres URL, TURNSTILE_SECRET_KEY,
# an https PUBLIC_APP_URL, and a delivering EMAIL_BACKEND (none exists yet — provider TBD).
ENVIRONMENT=local

# Postgres via docker-compose (recommended even locally):
DATABASE_URL=postgresql+asyncpg://taproga:taproga@localhost:5432/taproga
# Without Docker, SQLite works for local-only experiments:
# DATABASE_URL=sqlite+aiosqlite:///./local.db

# Generate with: uv run python -m app.cli generate-key   (never reuse between environments)
ENCRYPTION_KEY=replace-with-generated-key

# Origin of the Next.js app: used in email links and the CSRF origin check.
PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile secret. Leave empty locally to skip bot checks.
TURNSTILE_SECRET_KEY=

# HaveIBeenPwned k-anonymity check on new passwords (needs internet).
BREACH_CHECK_ENABLED=true

# console (prints emails to the worker's stdout) | memory (tests only)
EMAIL_BACKEND=console
EMAIL_FROM=Ta Proga <no-reply@taproga.com>

SQL_ECHO=false
LOG_LEVEL=INFO
HSTS_MAX_AGE_SECONDS=63072000
